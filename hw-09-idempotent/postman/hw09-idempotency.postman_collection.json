          }
        },
        {
          "name": "1.11 Verify Stock Reserved (2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Stock reserved', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.stock).to.equal(10);",
                  "    pm.expect(json.reserved).to.equal(2);",
                  "    pm.expect(json.available).to.equal(8);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{warehouseHost}}/api/v1/warehouse/stock/{{productId}}"
          }
        }
      ]
