          "name": "5.1 Setup - Full Test Environment",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var ts = Date.now();",
                  "pm.collectionVariables.set('userId', 'event-user-' + ts);",
                  "pm.collectionVariables.set('productId', 'event-prod-' + ts);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/accounts",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"user_id\": \"{{userId}}\"}"}
          }
        },
        {
          "name": "5.2 Deposit",
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/deposit",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"user_id\": \"{{userId}}\", \"amount\": 500}"}
          }
        },
        {
          "name": "5.3 Add Product",
          "request": {
            "method": "POST",
            "url": "{{warehouseHost}}/api/v1/warehouse/products",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"product_id\": \"{{productId}}\", \"quantity\": 5}"}
          }
        },
        {
          "name": "5.4 Add Delivery Slot",
          "request": {
            "method": "POST",
            "url": "{{deliveryHost}}/api/v1/delivery/slots",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"slot_time\": \"2025-01-20 14:00\"}"}
          }
        },
        {
          "name": "5.5 Create Order - Triggers Event Chain",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order triggers event: order.created', function() {",
                  "    pm.response.to.have.status(202);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('orderId', json.order_id);",
                  "    console.log('Event chain started: order.created');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 100, \"quantity\": 1}"}
          }
        },
        {
          "name": "5.6 Poll Order Status (expect events processed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["setTimeout(function(){}, 3000);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All events processed: billing.charged → warehouse.reserved → delivery.booked', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.state).to.equal('COMPLETED');",
                  "    console.log('Event chain completed successfully');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{orderHost}}/api/v1/orders/{{orderId}}"
          }
        },
        {
          "name": "5.7 Verify Event: billing.charged",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event billing.charged processed: balance decreased', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.equal(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{billingHost}}/api/v1/billing/accounts/{{userId}}"
          }
        },
        {
          "name": "5.8 Verify Event: warehouse.reserved",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Event warehouse.reserved processed: stock reserved', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.reserved).to.equal(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{warehouseHost}}/api/v1/warehouse/stock/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "6. Idempotency Tests",
      "item": [
        {
          "name": "6.1 Setup - Create Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var userId = 'idempotency-user-' + Date.now();",
                  "var productId = 'idempotency-prod-' + Date.now();",
                  "var idempotencyKey = 'key-' + Date.now();",
                  "pm.collectionVariables.set('userId', userId);",
                  "pm.collectionVariables.set('productId', productId);",
                  "pm.collectionVariables.set('idempotencyKey', idempotencyKey);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/accounts",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\"}"
            }
          }
        },
        {
          "name": "6.2 Deposit Funds",
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/deposit",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"amount\": 1000}"
            }
          }
        },
        {
          "name": "6.3 Add Product",
          "request": {
            "method": "POST",
            "url": "{{warehouseHost}}/api/v1/warehouse/products",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": \"{{productId}}\", \"quantity\": 10}"
            }
          }
        },
        {
          "name": "6.4 Add Delivery Slot",
          "request": {
            "method": "POST",
            "url": "{{deliveryHost}}/api/v1/delivery/slots",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"slot_time\": \"2025-01-15 10:00\"}"
            }
          }
        },
        {
          "name": "6.5 First Order Request (with Idempotency Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('First request: Order accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.order_id).to.exist;",
                  "    pm.collectionVariables.set('orderId', json.order_id);",
                  "});",
                  "",
                  "pm.test('No X-Idempotency-Key-Used header on first request', function() {",
                  "    pm.expect(pm.response.headers.has('X-Idempotency-Key-Used')).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Idempotency-Key", "value": "{{idempotencyKey}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 100, \"quantity\": 1}"
            }
          }
        },
        {
          "name": "6.6 Wait for Saga",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(function(){}, 3000);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{orderHost}}/health"
          }
        },
        {
          "name": "6.7 Retry Order Request (same Idempotency Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Retry returns same order_id', function() {",
                  "    var json = pm.response.json();",
                  "    var originalOrderId = pm.collectionVariables.get('orderId');",
                  "    pm.expect(json.order_id).to.equal(originalOrderId);",
                  "});",
                  "",
                  "pm.test('X-Idempotency-Key-Used header present', function() {",
                  "    pm.expect(pm.response.headers.get('X-Idempotency-Key-Used')).to.equal('true');",
                  "});",
                  "",
                  "pm.test('Idempotent response: no duplicate order', function() {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Idempotency-Key", "value": "{{idempotencyKey}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 100, \"quantity\": 1}"
            }
          }
        },
        {
          "name": "6.8 Verify Balance (charged only once)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance charged only once (900)', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.equal(900);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{billingHost}}/api/v1/billing/accounts/{{userId}}"
          }
        },
        {
          "name": "6.9 Third Retry (same key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Third retry still returns same order_id', function() {",
                  "    var json = pm.response.json();",
                  "    var originalOrderId = pm.collectionVariables.get('orderId');",
                  "    pm.expect(json.order_id).to.equal(originalOrderId);",
                  "});",
                  "",
                  "pm.test('X-Idempotency-Key-Used header present', function() {",
                  "    pm.expect(pm.response.headers.get('X-Idempotency-Key-Used')).to.equal('true');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Idempotency-Key", "value": "{{idempotencyKey}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 100, \"quantity\": 1}"
            }
          }
        },
        {
          "name": "6.10 Different Key Creates New Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('newIdempotencyKey', 'new-key-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Different key creates new order', function() {",
                  "    pm.response.to.have.status(202);",
                  "    var json = pm.response.json();",
                  "    var originalOrderId = pm.collectionVariables.get('orderId');",
                  "    pm.expect(json.order_id).to.not.equal(originalOrderId);",
                  "});",
                  "",
                  "pm.test('No X-Idempotency-Key-Used header (new order)', function() {",
                  "    pm.expect(pm.response.headers.has('X-Idempotency-Key-Used')).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "X-Idempotency-Key", "value": "{{newIdempotencyKey}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 100, \"quantity\": 1}"
            }
          }
        },
        {
          "name": "6.11 Verify Balance (charged twice now)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance charged twice (800)', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.equal(800);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{billingHost}}/api/v1/billing/accounts/{{userId}}"
          }
        }
      ]
    }
  ]
}
