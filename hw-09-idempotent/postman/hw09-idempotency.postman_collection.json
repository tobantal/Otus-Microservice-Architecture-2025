              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{warehouseHost}}/api/v1/warehouse/products",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\": \"{{productId}}\", \"quantity\": 10}"
            }
          }
        },
        {
          "name": "1.5 Check Stock Before Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Stock is 10, reserved is 0', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.stock).to.equal(10);",
                  "    pm.expect(json.reserved).to.equal(0);",
                  "    pm.expect(json.available).to.equal(10);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{warehouseHost}}/api/v1/warehouse/stock/{{productId}}"
          }
        },
        {
          "name": "1.6 Add Delivery Slot",
