              "mode": "raw",
              "raw": "{\"slot_time\": \"2025-01-15 10:00\"}"
            }
          }
        },
        {
          "name": "1.7 Create Order (Starts Saga)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.order_id).to.not.be.empty;",
                  "    pm.expect(json.status).to.equal('BILLING_PENDING');",
                  "    pm.collectionVariables.set('orderId', json.order_id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orderHost}}/api/v1/orders",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"product_id\": \"{{productId}}\", \"amount\": 500, \"quantity\": 2}"
            }
          }
