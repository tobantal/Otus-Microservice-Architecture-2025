        {
          "name": "1.8 Wait for Saga (2 sec)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(function(){}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Waited for processing', function() {",
                  "    pm.response.to.have.status(200);",
