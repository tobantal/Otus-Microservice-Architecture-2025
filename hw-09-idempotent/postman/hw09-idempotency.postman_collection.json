    {
      "name": "1. Happy Path - Full Saga Success",
      "item": [
        {
          "name": "1.1 Create Billing Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var userId = 'user-' + Date.now();",
                  "pm.collectionVariables.set('userId', userId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Account created', function() {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/accounts",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\"}"
            }
          }
        },
        {
          "name": "1.2 Deposit Funds (1000)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deposit successful', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.equal(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{billingHost}}/api/v1/billing/deposit",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"{{userId}}\", \"amount\": 1000}"
            }
          }
        },
        {
