          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance is 1000', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.balance).to.equal(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{billingHost}}/api/v1/billing/accounts/{{userId}}"
          }
        },
        {
          "name": "1.4 Add Product to Warehouse",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var productId = 'prod-' + Date.now();",
                  "pm.collectionVariables.set('productId', productId);"
